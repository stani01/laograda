# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin) — email-urile permise să se autentifice, separate prin virgulă.
# Contul trebuie creat manual în Supabase Studio > Authentication > Users > Add user.
ADMIN_EMAILS=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="La Ograda <onboarding@resend.dev>"
CONTACT_EMAIL_TO=

# iCal sync (import — citim ocuparea lor) — Booking.com: Extranet > Calendar >
# Sync calendars > Export. Airbnb: Calendar > Availability settings > Connect
# to another website (Export). Travelminit: Extranet > Calendar >
# Import/Export calendars > Export (iCal URL).
BOOKING_ICAL_URL=
AIRBNB_ICAL_URL=
TRAVELMINIT_ICAL_URL=

# iCal sync (export — /api/availability/ical?token=... expune rezervările
# noastre către Booking/Airbnb/Travelminit/iCloud). Generează un șir aleator
# lung (ex: `openssl rand -hex 32`) — e practic o parolă, nu-l distribui public.
ICAL_EXPORT_SECRET=

# NETOPIA Payments — configurat după deschiderea contului de comerciant + domeniu .ro
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_SANDBOX=true
